# Application Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3008

# Appwrite Configuration
# Get these from your Appwrite project dashboard
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT=your_appwrite_project_id_here

# Appwrite Database IDs
# These are collection/database IDs from your Appwrite project
NEXT_PUBLIC_APPWRITE_DATABASE_ID=your_database_id_here
NEXT_PUBLIC_APPWRITE_WORKSPACES_ID=your_workspaces_collection_id_here
NEXT_PUBLIC_APPWRITE_MEMBERS_ID=your_members_collection_id_here
NEXT_PUBLIC_APPWRITE_PROJECTS_ID=your_projects_collection_id_here
NEXT_PUBLIC_APPWRITE_TASKS_ID=your_tasks_collection_id_here
NEXT_PUBLIC_APPWRITE_IMAGES_BUCKET_ID=your_images_bucket_id_here

# Appwrite Server-side Key (Keep this secret!)
# Used for privileged server-side operations
NEXT_APPWRITE_KEY=your_appwrite_private_key_here
